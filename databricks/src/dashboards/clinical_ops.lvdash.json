{
  "datasets": [
    {
      "name": "ward_hourly",
      "displayName": "Ward by unit and hour",
      "queryLines": [
        "SELECT hour_ts, site_id, unit_id, census, n_high, alerts_raised, escalations,\n",
        "       mean_news2, census / 60.0 AS nurse_shifts  -- 1 nurse per 5 patients, 12 h\n",
        "FROM site_kpis_hourly\n",
        "ORDER BY hour_ts\n"
      ],
      "columns": [
        {
          "displayName": "Alerts per nurse per shift",
          "description": "Alerts raised / nurse-shifts (1 nurse per 5 patients, 12-hour shifts)",
          "expression": "SUM(`alerts_raised`) / SUM(`nurse_shifts`)"
        }
      ]
    },
    {
      "name": "ward_now",
      "displayName": "Patients at the latest hour",
      "queryLines": [
        "SELECT encounter_id, site_id, unit_id, prediction_ts, risk, risk_band,\n",
        "       CASE WHEN risk_band = 'High' THEN 1 ELSE 0 END AS is_high, news2_total,\n",
        "       get_json_object(top_factors, '$[0].factor') AS top_reason,\n",
        "       get_json_object(top_factors, '$[0].driver') AS top_reason_reading,\n",
        "       get_json_object(top_factors, '$[1].factor') AS second_reason\n",
        "FROM risk_scores\n",
        "WHERE prediction_ts = (SELECT max(prediction_ts) FROM risk_scores)\n",
        "ORDER BY risk DESC\n"
      ]
    },
    {
      "name": "alerts",
      "displayName": "Alerts and their outcomes",
      "queryLines": [
        "SELECT alert_ts, site_id, unit_id, risk, news2_total, hours_to_escalation,\n",
        "       CASE WHEN escalated_within_6h IS NULL THEN 'Not known yet'\n",
        "            WHEN escalated_within_6h = 1 THEN 'Escalated'\n",
        "            ELSE 'No escalation' END AS outcome,\n",
        "       CASE WHEN escalated_within_6h IS NULL THEN 0 ELSE 1 END AS outcome_known,\n",
        "       coalesce(escalated_within_6h, 0) AS escalated\n",
        "FROM alerts_fact\n",
        "ORDER BY alert_ts\n"
      ],
      "columns": [
        {
          "displayName": "Alert precision",
          "description": "Alerts followed by an escalation within 6 h, among alerts whose outcome is known",
          "expression": "SUM(`escalated`) / SUM(`outcome_known`)"
        }
      ]
    },
    {
      "name": "escalations",
      "displayName": "Escalations and whether they were flagged",
      "queryLines": [
        "SELECT e.event_ts, e.site_id, e.unit_id, e.encounter_id,\n",
        "       replace(e.event_type, '_', ' ') AS event_type,\n",
        "       CASE WHEN e.flagged_6h_before THEN 1 ELSE 0 END AS flagged,\n",
        "       CASE WHEN e.flagged_6h_before THEN 'Flagged in advance' ELSE 'Not flagged' END\n",
        "         AS flagged_label,\n",
        "       e.hours_flagged_before,\n",
        "       max(CASE WHEN r.news2_total >= 5 THEN 1 ELSE 0 END) AS news2_5_before\n",
        "FROM escalations_fact e\n",
        "LEFT JOIN risk_scores r\n",
        "  ON r.encounter_id = e.encounter_id\n",
        " AND r.prediction_ts >= timestampadd(HOUR, -6, e.event_ts)\n",
        " AND r.prediction_ts < e.event_ts\n",
        "GROUP BY ALL\n",
        "ORDER BY e.event_ts\n"
      ]
    },
    {
      "name": "devices",
      "displayName": "Device health by day",
      "queryLines": [
        "SELECT date, site_id, device_id, uptime_pct / 100 AS uptime, battery_outages,\n",
        "       stuck_minutes, messages_received, messages_expected\n",
        "FROM device_health_daily\n",
        "ORDER BY date\n"
      ]
    },
    {
      "name": "data_quality",
      "displayName": "Pipeline expectations (latest run)",
      "queryLines": [
        "WITH latest AS (\n",
        "  SELECT max_by(origin.update_id, timestamp) AS update_id\n",
        "  FROM monitoring.medallion_event_log WHERE event_type = 'update_progress')\n",
        "SELECT split_part(origin.flow_name, '.', 2) AS layer,\n",
        "       split_part(origin.flow_name, '.', 3) AS table_name,\n",
        "       e.name AS expectation, e.passed_records AS passed, e.failed_records AS failed,\n",
        "       timestamp AS checked_at\n",
        "FROM monitoring.medallion_event_log\n",
        "LATERAL VIEW explode(from_json(details:flow_progress.data_quality.expectations,\n",
        "  'array<struct<name:string,dataset:string,passed_records:bigint,failed_records:bigint>>'))\n",
        "  x AS e\n",
        "WHERE event_type = 'flow_progress' AND origin.update_id = (SELECT update_id FROM latest)\n",
        "ORDER BY failed DESC, layer, table_name, expectation\n"
      ]
    },
    {
      "name": "reconciliation",
      "displayName": "Readings reconciled, Bronze to Silver",
      "queryLines": [
        "SELECT bronze_rows, in_silver, quarantined, duplicates, missing_from_silver, linked,\n",
        "       not_on_a_patient\n",
        "FROM silver.vitals_reconciliation\n"
      ]
    }
  ],
